      <form id="loginForm">

        <div class="form-group">
          <label for="email">Student Email</label>
          <input
            type="email"
            id="email"
            placeholder="Enter your student email"
            required
          >
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            placeholder="Enter your password"
            required
          >
        </div>

